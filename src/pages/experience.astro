<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101d39"><meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex"><title>{title}</title><style is:global>
:root{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1c2c49;background:#f5f7fc}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer;border:1px solid #dfe5f0;background:white;color:#2c4268;border-radius:12px;padding:11px 14px;font-weight:650;transition:.16s}button:hover{filter:brightness(.97)}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #a6b5ff}button.primary{background:#5267e9;color:white;border-color:#5267e9}button.danger{color:#b23d51;border-color:#f1d4d8}input,select,textarea{padding:11px 12px;border:1px solid #dce4ef;border-radius:11px;background:white;color:#263b59;max-width:100%;min-width:0}textarea{width:100%;min-height:80px}.app{display:grid;grid-template-columns:248px minmax(0,1fr);min-height:100vh}.side{background:#101e39;color:white;padding:25px 15px;display:flex;flex-direction:column;gap:16px}.brand{font-size:27px;font-weight:850;letter-spacing:-1.4px;padding:5px 12px}.brand b{color:#9baaff}.side .minor{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#8fa1c3;margin:8px 12px}.side select{width:100%;background:#243553;color:#fff;border-color:#354967}.side button.nav{width:100%;text-align:left;border:0;background:transparent;color:#bac8e2;padding:13px 12px;display:flex;gap:9px;align-items:center}.side button.nav.selected{background:#2a3c68;color:#fff}.side button.nav:hover{background:#273857}.side .foot{margin-top:auto;font-size:11px;color:#91a1bf;padding:12px}.main{min-width:0}.top{background:#fff;border-bottom:1px solid #e8edf5;min-height:75px;padding:15px 28px;display:flex;justify-content:space-between;align-items:center;gap:15px}.top h1{margin:0;font-size:23px;letter-spacing:-.8px}.top p{margin:4px 0 0;color:#8490a3;font-size:12px}.avatar{background:#e9edff;color:#465bd0;border-radius:50%;width:38px;height:38px;display:grid;place-items:center;font-weight:800}.body{padding:25px 28px;max-width:1400px;margin:auto}.id{font:10px ui-monospace,SFMono-Regular,monospace;color:#7470a8;background:#f2f0ff;border:1px solid #e7e3fc;padding:2px 4px;border-radius:5px;margin-right:4px;white-space:nowrap}.side .id{background:#263659;color:#b9c7ff;border-color:#46547c}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.panel,.metric{background:#fff;border:1px solid #e6eaf2;border-radius:19px;padding:22px;box-shadow:0 9px 35px #27395708;margin-bottom:17px}.metric{margin:0}.metric .value{font-size:32px;font-weight:850;letter-spacing:-1px;margin:12px 0 0;color:#233e78}.metric small{color:#7e8ca3}.section{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin:5px 0 15px}.section h2{font-size:18px;margin:0;letter-spacing:-.4px}.section p{font-size:13px;color:#7c8ba0;margin:5px 0 0}.actions{display:flex;gap:8px;flex-wrap:wrap}.tablewrap{overflow:auto;border:1px solid #edf0f5;border-radius:13px}table{width:100%;border-collapse:collapse;min-width:580px}td,th{padding:14px 12px;text-align:left;border-bottom:1px solid #eef1f6;font-size:13px}th{color:#8290a3;font-size:11px;text-transform:uppercase;letter-spacing:.6px;background:#fafbfe}tbody tr:hover{background:#fafbff}td button{font-size:12px;padding:7px 9px}.pill{display:inline-flex;padding:5px 10px;border-radius:100px;background:#edf2ff;color:#4960d0;font-size:12px;font-weight:700}.pill.ok{background:#e5f7ef;color:#1d8960}.pill.warn{background:#fff3db;color:#a87512}.two{display:grid;grid-template-columns:1.3fr 1fr;gap:17px}.field{display:grid;gap:6px;font-size:12px;color:#64748b}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.formgrid .wide{grid-column:1/-1}.hint{font-size:12px;color:#8190a4}.demo{border:1px solid #e6eaf2;border-radius:17px;background:#f9fbff;padding:15px}.phone{width:min(100%,380px);border:7px solid #233653;border-radius:37px;margin:12px auto;background:#fff;min-height:570px;box-shadow:0 24px 50px #1a32502b;padding:18px 15px}.phonehead{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e7ecf3;padding-bottom:15px}.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin:16px 0}.tabs button{font-size:11px;padding:10px 3px}.tabs button.selected{background:#eef1ff;color:#3e56d0;border-color:#d7dfff}.clockface{text-align:center;background:linear-gradient(140deg,#f0f3ff,#f9fbff);border-radius:20px;padding:23px 10px;margin:15px 0}.clockface strong{font-size:36px;letter-spacing:-1px;display:block}.clockface small{color:#73839e}.phone .primary{width:100%;padding:16px}.entry{display:flex;justify-content:space-between;gap:10px;align-items:center;border-bottom:1px solid #edf0f5;padding:13px 0;font-size:13px}.entry small{color:#7c8ca3}.empty{padding:25px;text-align:center;color:#8795a8}.modalbg{position:fixed;inset:0;background:#111f3bb3;display:grid;place-items:center;z-index:20;padding:15px;backdrop-filter:blur(4px)}.modal{width:min(550px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:22px;padding:25px;box-shadow:0 25px 70px #08172b50}.modal h2{margin:0 0 17px}.modal form{display:grid;gap:14px}.hidden{display:none!important}.toast{position:fixed;right:20px;bottom:20px;background:#173a32;color:white;padding:13px 18px;border-radius:12px;box-shadow:0 12px 35px #172b3a35;z-index:30;max-width:calc(100vw - 40px)}.bar{height:10px;background:#edf1fa;border-radius:10px;overflow:hidden}.bar span{display:block;background:#6e82ed;height:100%;border-radius:10px}.banner{background:#edf2ff;border:1px solid #dce5ff;padding:14px;border-radius:13px;color:#3d5295;font-size:13px;margin:12px 0}.subnav{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:17px}.subnav button.selected{background:#edf0ff;color:#4a5ecb;border-color:#cfd9ff}
@media(max-width:1150px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.two{grid-template-columns:1fr}.app{grid-template-columns:215px minmax(0,1fr)}}
@media(max-width:760px){.app{display:block}.side{padding:13px;gap:8px}.brand{font-size:23px;padding:0 5px}.side .minor,.side .foot{display:none}.side>div:first-of-type{display:flex;gap:10px;align-items:center}.side select{max-width:240px}.side nav{display:flex;overflow-x:auto;gap:5px;-webkit-overflow-scrolling:touch}.side button.nav{width:auto;flex:0 0 auto;white-space:nowrap;font-size:12px;padding:10px}.top{padding:15px;min-height:65px}.top h1{font-size:20px}.body{padding:14px}.panel{padding:17px;border-radius:15px}.metric{padding:16px}.grid{gap:10px}.metric .value{font-size:28px}.section{align-items:flex-start}.formgrid{grid-template-columns:1fr}.formgrid .wide{grid-column:auto}.modal{padding:19px}.two{gap:0}.actions button{font-size:12px}}
@media(max-width:390px){.grid{grid-template-columns:1fr 1fr}.metric{padding:12px}.metric .value{font-size:25px}.metric small{font-size:11px}}
</style></head><body><div class="app"><aside class="side"><div><div class="brand">docu<b>7</b> <span style="font-size:10px;font-weight:500;color:#95a7c7">STUDIO</span></div></div><div><div class="minor">Mandant</div><select id="tenantSelect" aria-label="Mandant auswählen"></select></div><nav id="navigation"></nav><div class="foot">High-Fidelity-Demo · lokale Beispieldaten<br>Keine echten Mitarbeiterdaten eingeben</div></aside><main class="main"><header class="top"><div><h1 id="heading">Übersicht</h1><p id="subtitle">Dein interaktiver Docu7-Prototyp</p></div><div class="actions"><button id="reset"><span class="id">X04</span> Reset</button><span class="avatar">D7</span></div></header><div class="body" id="view"></div></main></div><div id="modalRoot" class="modalbg hidden"><div class="modal"><div class="section"><h2 id="modalHeading"></h2><button id="closeModal"><span class="id">X09</span> ✕</button></div><div id="modalContent"></div></div></div><div class="toast hidden" id="toast"></div>
<script is:inline>
(function(){
const sample={tenant:'a',tenants:[{id:'a',name:'Musterfirma Nord',sector:'Handwerk'},{id:'b',name:'Beispielbetrieb Süd',sector:'Dienstleistung'}],employees:[{id:'e1',tenant:'a',name:'Anna Becker',lang:'Deutsch',role:'Mitarbeiter',active:true},{id:'e2',tenant:'a',name:'Marek Nowak',lang:'Polski',role:'Mitarbeiter',active:true},{id:'e3',tenant:'b',name:'Elena Popescu',lang:'Română',role:'Teamleitung',active:true}],entries:[{id:'z1',tenant:'a',employee:'e1',date:'2026-10-15',start:'08:00',end:'16:30',pause:30,source:'Stempeluhr',history:[]},{id:'z2',tenant:'a',employee:'e2',date:'2026-10-15',start:'09:00',end:'',pause:0,source:'Stempeluhr',history:[]},{id:'z3',tenant:'b',employee:'e3',date:'2026-10-15',start:'08:30',end:'17:00',pause:45,source:'Stempeluhr',history:[]}],settings:{},events:[],notes:[]};
const storage='docu7-experience-v1';let s;try{s=JSON.parse(localStorage.getItem(storage))}catch{}if(!s||!Array.isArray(s.tenants))s=JSON.parse(JSON.stringify(sample));let page='dashboard',mobileTab='clock',selectedEmployee='',timeFilter='all',employeeSearch='';
const $=q=>document.querySelector(q);const h=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const x=id=>'<span class="id">'+id+'</span>';const t=()=>s.tenants.find(z=>z.id===s.tenant);const staff=()=>s.employees.filter(z=>z.tenant===s.tenant);const entries=()=>s.entries.filter(z=>z.tenant===s.tenant);const emp=id=>s.employees.find(e=>e.id===id);const key=prefix=>prefix+Date.now().toString(36)+Math.random().toString(36).slice(2,5);const today=()=>new Date().toLocaleDateString('en-CA');const time=()=>new Date().toTimeString().slice(0,5);const fmt=date=>date?new Date(date+'T12:00:00').toLocaleDateString('de-DE'):'—';function persist(){localStorage.setItem(storage,JSON.stringify(s))}function notify(message){const el=$('#toast');el.textContent=message;el.classList.remove('hidden');setTimeout(()=>el.classList.add('hidden'),2800)}function btn(id,label,act,kind=''){return '<button class="'+kind+'" data-action="'+act+'">'+x(id)+h(label)+'</button>'}
const menu=[['dashboard','X10','▦','Übersicht'],['tenants','X11','▤','Mandanten'],['employees','X20','♙','Mitarbeiter'],['times','X30','◷','Arbeitszeiten'],['mobile','X40','▣','Mitarbeiter-App'],['settings','X50','⚙','Verwaltung'],['feedback','X60','✎','Änderungswünsche']];
function shell(){$('#tenantSelect').innerHTML=s.tenants.map(z=>'<option value="'+h(z.id)+'" '+(z.id===s.tenant?'selected':'')+'>'+h(z.name)+'</option>').join('');$('#navigation').innerHTML=menu.map(z=>'<button class="nav '+(page===z[0]?'selected':'')+'" data-action="page:'+z[0]+'">'+x(z[1])+z[2]+' '+z[3]+'</button>').join('');$('#heading').textContent=menu.find(z=>z[0]===page)?.[3]||'Docu7';$('#subtitle').textContent=t()?.name+' · Interaktiver Prototyp'}
function render(){shell();const map={dashboard,tenants,employees,times,mobile,settings,feedback};$('#view').innerHTML=map[page]();wire()}
function metric(id,label,value,detail){return '<div class="metric">'+x(id)+'<small>'+label+'</small><div class="value">'+value+'</div><small>'+detail+'</small></div>'}
function dashboard(){const e=entries(),open=e.filter(z=>!z.end).length;return '<div class="grid">'+metric('X12','Mitarbeiter',staff().length,'Dieser Mandant')+metric('X13','Zeitbuchungen',e.length,'Gesamt in der Demo')+metric('X14','Offene Zeiten',open,'Benötigen Aufmerksamkeit')+metric('X15','Erfasste Stunden',hours(e).toFixed(1).replace('.',','),'Ohne offene Einträge')+'</div><div class="two" style="margin-top:17px"><div class="panel"><div class="section"><div><h2>'+x('X16')+'Schnellaktionen</h2><p>Probiere echte Abläufe in der Demo aus.</p></div></div><div class="actions">'+btn('X17','Mitarbeiter anlegen','employee:new','primary')+btn('X18','Zeit nachtragen','entry:new')+btn('X19','Mitarbeiter-App öffnen','page:mobile')+'</div><div class="banner">Alle Aktionen verändern sofort die Demo-Daten. Wechselst du zur Mitarbeiter-App, siehst du dieselben Buchungen.</div></div><div class="panel"><div class="section"><h2>'+x('X1A')+'Letzte Aktivitäten</h2></div>'+(s.events.filter(z=>z.tenant===s.tenant).slice(-5).reverse().map(z=>'<div class="entry"><div>'+h(z.text)+'<br><small>'+h(z.at)+'</small></div></div>').join('')||'<div class="empty">Noch keine Aktivitäten. Starte mit einer Aktion.</div>')+'</div></div><div class="panel"><div class="section"><h2>'+x('X1B')+'Mitarbeiter heute</h2>'+btn('X1C','Alle Zeiten','page:times')+'</div>'+entryTable(e.slice(-5))+'</div>'}
function hours(list){return list.reduce((sum,z)=>{if(!z.end)return sum;const a=z.start.split(':').map(Number),b=z.end.split(':').map(Number);let minutes=(b[0]*60+b[1])-(a[0]*60+a[1])-Number(z.pause||0);return sum+Math.max(0,minutes)/60},0)}
function tenants(){return '<div class="panel"><div class="section"><div><h2>'+x('X70')+'Firmen / Mandanten</h2><p>Jede Firma erhält getrennte Mitarbeiter und Zeitbuchungen.</p></div>'+btn('X71','+ Firma anlegen','tenant:new','primary')+'</div><div class="grid">'+s.tenants.map(z=>'<div class="metric"><strong>'+h(z.name)+'</strong><p class="hint">'+h(z.sector||'Keine Branche')+'</p><div class="value">'+s.employees.filter(e=>e.tenant===z.id).length+'</div><small>Mitarbeiter</small><p>'+btn('X72','Öffnen','tenant:switch:'+z.id')+' '+btn('X73','Bearbeiten','tenant:edit:'+z.id)+'</p></div>').join('')+'</div></div>'}
function employees(){const list=staff().filter(z=>z.name.toLowerCase().includes(employeeSearch.toLowerCase()));return '<div class="panel"><div class="section"><div><h2>'+x('X21')+'Mitarbeiterverzeichnis</h2><p>Einfach anlegen, auch ohne E-Mail-Adresse.</p></div>'+btn('X22','+ Mitarbeiter','employee:new','primary')+'</div><div class="field" style="max-width:340px;margin-bottom:15px"><label>'+x('X23')+'Suche</label><input id="employeeSearch" placeholder="Name suchen …" value="'+h(employeeSearch)+'"></div><div class="tablewrap"><table><thead><tr><th>Mitarbeiter</th><th>Sprache</th><th>Rolle</th><th>Status</th><th>Aktion</th></tr></thead><tbody>'+list.map(z=>'<tr><td><strong>'+h(z.name)+'</strong></td><td>'+h(z.lang)+'</td><td>'+h(z.role)+'</td><td><span class="pill '+(z.active?'ok':'warn')+'">'+(z.active?'Aktiv':'Inaktiv')+'</span></td><td>'+btn('X27','Bearbeiten','employee:edit:'+z.id)+'</td></tr>').join('')+'</tbody></table></div></div>'}
function entryTable(list){return '<div class="tablewrap"><table><thead><tr><th>Datum</th><th>Mitarbeiter</th><th>Beginn</th><th>Ende</th><th>Pause</th><th>Stunden</th><th>Aktion</th></tr></thead><tbody>'+list.map(z=>'<tr><td>'+fmt(z.date)+'</td><td>'+h(emp(z.employee)?.name)+'</td><td>'+h(z.start)+'</td><td><span class="pill '+(z.end?'ok':'warn')+'">'+h(z.end||'Offen')+'</span></td><td>'+z.pause+' min</td><td>'+hours([z]).toFixed(2).replace('.',',')+'</td><td>'+btn('X35','Korrigieren','entry:edit:'+z.id)+' '+btn('X36','Verlauf','entry:history:'+z.id)+'</td></tr>').join('')+'</tbody></table></div>'}
function times(){const list=entries().filter(z=>timeFilter==='all'||z.employee===timeFilter).sort((a,b)=>b.date.localeCompare(a.date));return '<div class="panel"><div class="section"><div><h2>'+x('X31')+'Zeiterfassungen</h2><p>Alle Buchungen inklusive manueller Änderungen.</p></div><div class="actions">'+btn('X32','+ Zeit nachtragen','entry:new','primary')+btn('X3F','CSV exportieren','export:csv')+'</div></div><div class="field" style="max-width:300px;margin-bottom:15px"><label>'+x('X33')+'Mitarbeiterfilter</label><select id="timeFilter"><option value="all">Alle Mitarbeiter</option>'+staff().map(z=>'<option value="'+z.id+'" '+(timeFilter===z.id?'selected':'')+'>'+h(z.name)+'</option>').join('')+'</select></div>'+entryTable(list)+'</div><div class="banner">'+x('X38')+'Zeitkorrekturen benötigen eine Begründung. Der Verlauf bleibt in der Demo nachvollziehbar. Für eine echte App wäre eine manipulationssichere serverseitige Speicherung erforderlich.</div>'}
function mobile(){const person=staff().find(z=>z.id===selectedEmployee)||staff()[0];if(person)selectedEmployee=person.id;const mine=entries().filter(z=>z.employee===selectedEmployee).sort((a,b)=>b.date.localeCompare(a.date));const active=mine.find(z=>z.date===today()&&!z.end);return '<div class="two"><div class="panel"><div class="section"><div><h2>'+x('X41')+'Mitarbeiter-App</h2><p>Simulierte Smartphone-App mit gemeinsamen Demodaten.</p></div></div><div class="field"><label>'+x('X42')+'Mitarbeiter auswählen</label><select id="mobilePerson">'+staff().map(z=>'<option value="'+z.id+'" '+(selectedEmployee===z.id?'selected':'')+'>'+h(z.name)+'</option>').join('')+'</select></div><div class="phone"><div class="phonehead"><strong>docu<span style="color:#5368ea">7</span></strong><span class="pill">'+h(person?.lang||'Deutsch')+'</span></div><p style="font-size:13px;color:#8391a4;margin:14px 0 0">Hallo, '+h(person?.name?.split(' ')[0]||'Team')+' 👋</p><div class="tabs">'+[['clock','X43','Stempeluhr'],['list','X44','Meine Zeiten'],['profile','X45','Profil']].map(z=>'<button class="'+(mobileTab===z[0]?'selected':'')+'" data-action="mobile:tab:'+z[0]+'">'+x(z[1])+z[2]+'</button>').join('')+'</div>'+(mobileTab==='clock'?'<div class="clockface"><small>'+x('X46')+'Heute · '+fmt(today())+'</small><strong id="liveClock">'+time()+'</strong><span class="pill '+(active?'ok':'')+'">'+(active?'Arbeitszeit läuft':'Nicht eingestempelt')+'</span></div>'+btn('X47',active?'Ausstempeln':'Einstempeln','mobile:stamp','primary')+(active?'<p>'+btn('X4A','Pause erfassen','mobile:pause')+'</p>':'')+'<p class="hint" style="text-align:center">Einfach ein- und ausstempeln. Mehr ist nicht nötig.</p>':mobileTab==='list'?'<h3>'+x('X48')+'Meine Zeiten</h3>'+(mine.map(z=>'<div class="entry"><div><strong>'+fmt(z.date)+'</strong><br><small>'+z.start+' – '+(z.end||'Offen')+' · '+z.pause+' Min. Pause</small></div><span class="pill '+(z.end?'ok':'warn')+'">'+(z.end?'Erfasst':'Offen')+'</span></div>').join('')||'<div class="empty">Noch keine Einträge.</div>')+'<p>'+btn('X49','Fehlenden Tag nachtragen','mobile:manual','primary')+'</p>':'<h3>'+x('X4B')+'Mein Profil</h3><p><strong>'+h(person?.name)+'</strong></p><p>Sprache: '+h(person?.lang)+'</p><p>Firma: '+h(t()?.name)+'</p><p class="hint">Sprache und Zugriffsrechte werden vom Arbeitgeber festgelegt.</p>')+'</div></div><div class="panel"><h2>'+x('X4C')+'Mitarbeiter-Erlebnis</h2><p>Für Mitarbeiter ist Docu7 bewusst reduziert: Stempeluhr, eigene Zeiten, fehlende Einträge und Profil.</p><div class="banner">Die hier erfassten Zeiten erscheinen sofort im Arbeitgeber-Bereich „Arbeitszeiten“ (X30).</div><p class="hint">Demo: Es wird kein echter Arbeitsbeginn dokumentiert. Datum und Uhrzeit kommen vom Gerät. Offene Tage können im Nachtragsdialog ergänzt werden.</p></div></div>'}
function settings(){const cfg=s.settings[s.tenant]||{};return '<div class="two"><div class="panel"><h2>'+x('X51')+'Firmen-Einstellungen</h2><div class="formgrid"><div class="field"><label>'+x('X52')+'Standardsprache</label><select id="settingLanguage">'+languages.map(z=>'<option '+(cfg.lang===z?'selected':'')+'>'+z+'</option>').join('')+'</select></div><div class="field"><label>'+x('X53')+'Arbeitszeitmodell</label><select id="settingModel"><option>Flexible Arbeitszeit</option><option '+(cfg.model==='Feste Arbeitszeit'?'selected':'')+'>Feste Arbeitszeit</option></select></div></div><p>'+btn('X54','Einstellungen speichern','settings:save','primary')+'</p></div><div class="panel"><h2>'+x('X55')+'Rechte & Datenschutz</h2><p>Konzept: Admins können Zeiten korrigieren. Mitarbeiter sehen nur ihre eigenen Zeiten. Änderungen benötigen einen Grund und werden protokolliert.</p><div class="banner">Die Rechte sind hier nur visualisiert, nicht technisch durchgesetzt. Keine echten personenbezogenen Daten verwenden.</div></div></div><div class="panel"><h2>'+x('X56')+'Interaktive Hilfe</h2><p>Wie lege ich einen Mitarbeiter an?</p>'+btn('X57','Anleitung anzeigen','help:show')+'<div id="helpResult"></div></div>'}
function feedback(){return '<div class="two"><div class="panel"><h2>'+x('X61')+'Änderungswunsch erfassen</h2><p class="hint">Beispiel: X35 – Zeitkorrektur soll zusätzliche Auswahl erhalten.</p><div class="formgrid"><div class="field"><label>'+x('X62')+'Element-ID</label><input id="noteId" placeholder="X35"></div><div class="field"><label>'+x('X63')+'Priorität</label><select id="notePriority"><option>Wichtig</option><option>Später</option><option>Idee</option></select></div><div class="field wide"><label>'+x('X64')+'Beschreibung</label><textarea id="noteText" placeholder="Was soll sich ändern?"></textarea></div></div><p>'+btn('X65','Änderungswunsch speichern','note:save','primary')+'</p></div><div class="panel"><div class="section"><h2>'+x('X66')+'Änderungsliste</h2>'+btn('X67','JSON exportieren','export:json')+'</div>'+(s.notes.map(z=>'<div class="entry"><div><strong>'+h(z.id)+'</strong> · '+h(z.priority)+'<br><small>'+h(z.text)+'</small></div>'+btn('X68','Löschen','note:delete:'+z.key)+'</div>').join('')||'<div class="empty">Noch keine Änderungswünsche gespeichert.</div>')+'</div></div><div class="banner">Änderungswünsche bleiben lokal auf diesem Gerät. Für gemeinsame Live-Bearbeitung benötigen wir später eine zentrale Speicherung.</div>'}
const languages=['Deutsch','English','Polski','Română','Türkçe','Українська','العربية','Русский'];function input(name,id,label,value='',type='text',required=''){return '<div class="field"><label>'+x(id)+label+'</label><input name="'+name+'" type="'+type+'" value="'+h(value)+'" '+required+'></div>'}
function modal(title,body,done){$('#modalHeading').textContent=title;$('#modalContent').innerHTML='<form id="editorForm">'+body+'</form>';$('#modalRoot').classList.remove('hidden');$('#editorForm').onsubmit=e=>{e.preventDefault();done(new FormData(e.target))}}function close(){$('#modalRoot').classList.add('hidden')}$('#closeModal').onclick=close;$('#modalRoot').onclick=e=>{if(e.target===$('#modalRoot'))close()};
function employeeEditor(z){modal(z?'Mitarbeiter bearbeiten':'Mitarbeiter anlegen','<div class="formgrid">'+input('name','X28','Vor- und Nachname',z?.name||'','text','required')+'<div class="field"><label>'+x('X29')+'App-Sprache</label><select name="lang">'+languages.map(l=>'<option '+(z?.lang===l?'selected':'')+'>'+l+'</option>').join('')+'</select></div><div class="field"><label>'+x('X2A')+'Rolle</label><select name="role">'+['Mitarbeiter','Teamleitung','Admin'].map(l=>'<option '+(z?.role===l?'selected':'')+'>'+l+'</option>').join('')+'</select></div><div class="field"><label>'+x('X2B')+'Status</label><select name="active"><option value="yes">Aktiv</option><option value="no" '+(z&&!z.active?'selected':'')+'>Inaktiv</option></select></div></div><p class="hint">Keine E-Mail erforderlich.</p><button class="primary">'+x('X2C')+'Speichern</button>',f=>{const obj={id:z?.id||key('e'),tenant:s.tenant,name:f.get('name'),lang:f.get('lang'),role:f.get('role'),active:f.get('active')==='yes'};if(z)Object.assign(z,obj);else s.employees.push(obj);log('Mitarbeiter '+(z?'bearbeitet: ':'angelegt: ')+obj.name);persist();close();render();notify('Mitarbeiter gespeichert')})}
function tenantEditor(z){modal(z?'Firma bearbeiten':'Neue Firma','<div class="formgrid">'+input('name','X74','Firmenname',z?.name||'','text','required')+input('sector','X75','Branche',z?.sector||'')+'</div><button class="primary">'+x('X76')+'Speichern</button>',f=>{if(z){z.name=f.get('name');z.sector=f.get('sector')}else{const o={id:key('t'),name:f.get('name'),sector:f.get('sector')};s.tenants.push(o);s.tenant=o.id}persist();close();render();notify('Firma gespeichert')})}
function entryEditor(z,onlyEmployee){const list=staff();if(!list.length){notify('Bitte zuerst Mitarbeiter anlegen');return}const who=onlyEmployee||z?.employee||list[0].id;modal(z?'Arbeitszeit korrigieren':'Arbeitszeit nachtragen','<div class="formgrid"><div class="field"><label>'+x('X37')+'Mitarbeiter</label><select name="employee">'+list.map(e=>'<option value="'+e.id+'" '+(who===e.id?'selected':'')+'>'+h(e.name)+'</option>').join('')+'</select></div>'+input('date','X39','Datum',z?.date||today(),'date','required')+input('start','X3A','Beginn',z?.start||'08:00','time','required')+input('end','X3B','Ende',z?.end||'17:00','time','required')+input('pause','X3C','Pause (Minuten)',z?.pause??30,'number','required min="0" max="1440"')+'<div class="field wide"><label>'+x('X3D')+'Begründung</label><textarea name="reason" required placeholder="z. B. Ausstempeln vergessen"></textarea></div></div><button class="primary">'+x('X3E')+'Zeit speichern</button>',f=>{const obj={employee:f.get('employee'),date:f.get('date'),start:f.get('start'),end:f.get('end'),pause:Number(f.get('pause'))};if(z){z.history.push({at:new Date().toISOString(),reason:f.get('reason'),before:{...z,history:undefined}});Object.assign(z,obj)}else s.entries.push({id:key('z'),tenant:s.tenant,...obj,source:'Nachtrag',history:[{at:new Date().toISOString(),reason:f.get('reason'),before:null}]});log('Zeitbuchung '+(z?'korrigiert':'nachgetragen')+' · '+emp(obj.employee)?.name);persist();close();render();notify('Zeitbuchung gespeichert')})}
function log(text){s.events.push({tenant:s.tenant,text,at:new Date().toLocaleString('de-DE')})}
function stamp(){if(!selectedEmployee)return;const open=entries().find(z=>z.employee===selectedEmployee&&z.date===today()&&!z.end);if(open){open.end=time();open.history.push({at:new Date().toISOString(),reason:'Ausstempeln (Demo)',before:null});log(emp(selectedEmployee).name+' hat ausgestempelt')}else{s.entries.push({id:key('z'),tenant:s.tenant,employee:selectedEmployee,date:today(),start:time(),end:'',pause:0,source:'Stempeluhr',history:[]});log(emp(selectedEmployee).name+' hat eingestempelt')}persist();render();notify(open?'Erfolgreich ausgestempelt':'Erfolgreich eingestempelt')}
function pause(){const open=entries().find(z=>z.employee===selectedEmployee&&z.date===today()&&!z.end);if(!open)return;modal('Pause erfassen',input('minutes','X4D','Pausendauer (Minuten)','30','number','required min="1" max="480"')+'<button class="primary">'+x('X4E')+'Pause speichern</button>',f=>{open.pause+=Number(f.get('minutes'));log(emp(selectedEmployee).name+' hat Pause erfasst');persist();close();render();notify('Pause hinzugefügt')})}
function exportData(kind){let text,mime,filename;if(kind==='csv'){const rows=[['Datum','Mitarbeiter','Beginn','Ende','Pause_Min','Stunden'],...entries().map(z=>[z.date,emp(z.employee)?.name,z.start,z.end,z.pause,hours([z]).toFixed(2)])];text='\uFEFF'+rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(';')).join('\r\n');mime='text/csv';filename='docu7-zeiten.csv'}else{text=JSON.stringify({exportedAt:new Date().toISOString(),data:s},null,2);mime='application/json';filename='docu7-demo.json'}const url=URL.createObjectURL(new Blob([text],{type:mime}));const a=document.createElement('a');a.href=url;a.download=filename;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
function act(a){if(a.startsWith('page:')){page=a.slice(5);render();return}if(a==='employee:new')return employeeEditor();if(a.startsWith('employee:edit:'))return employeeEditor(emp(a.slice(14)));if(a==='tenant:new')return tenantEditor();if(a.startsWith('tenant:edit:'))return tenantEditor(s.tenants.find(z=>z.id===a.slice(12)));if(a.startsWith('tenant:switch:')){s.tenant=a.slice(14);selectedEmployee='';persist();render();return}if(a==='entry:new')return entryEditor();if(a.startsWith('entry:edit:'))return entryEditor(s.entries.find(z=>z.id===a.slice(11)));if(a.startsWith('entry:history:')){const z=s.entries.find(z=>z.id===a.slice(14));return modal('Änderungsverlauf','<div>'+((z?.history||[]).map(v=>'<div class="entry"><div><strong>'+h(v.reason)+'</strong><br><small>'+h(v.at)+'</small><p class="hint">'+h(v.before?JSON.stringify(v.before):'Neuer Eintrag')+'</p></div></div>').join('')||'Keine Änderungen')+'</div><button>Schließen</button>',()=>close())}if(a.startsWith('mobile:tab:')){mobileTab=a.slice(11);render();return}if(a==='mobile:stamp')return stamp();if(a==='mobile:pause')return pause();if(a==='mobile:manual')return entryEditor(null,selectedEmployee);if(a==='settings:save'){s.settings[s.tenant]={lang:$('#settingLanguage').value,model:$('#settingModel').value};persist();notify('Einstellungen gespeichert');return}if(a==='help:show'){$('#helpResult').innerHTML='<div class="banner">Öffne X20 „Mitarbeiter“, wähle X22 „+ Mitarbeiter“, trage bei X28 den Namen ein, wähle X29 die Sprache und speichere über X2C.</div>';return}if(a==='note:save'){const id=$('#noteId').value.trim(),text=$('#noteText').value.trim();if(!id||!text){notify('Bitte ID und Beschreibung eingeben');return}s.notes.push({key:key('n'),id,priority:$('#notePriority').value,text});persist();render();notify('Änderungswunsch gespeichert');return}if(a.startsWith('note:delete:')){s.notes=s.notes.filter(z=>z.key!==a.slice(12));persist();render();return}if(a.startsWith('export:'))return exportData(a.slice(7))}
function wire(){document.querySelectorAll('[data-action]').forEach(el=>el.onclick=()=>act(el.dataset.action));const p=$('#mobilePerson');if(p)p.onchange=e=>{selectedEmployee=e.target.value;render()};const q=$('#timeFilter');if(q)q.onchange=e=>{timeFilter=e.target.value;render()};const search=$('#employeeSearch');if(search)search.oninput=e=>{employeeSearch=e.target.value;const pos=search.selectionStart;render();const next=$('#employeeSearch');next.focus();next.setSelectionRange(pos,pos)}}
$('#tenantSelect').onchange=e=>{s.tenant=e.target.value;selectedEmployee='';persist();render()};$('#reset').onclick=()=>{if(confirm('Alle lokalen Demo-Daten zurücksetzen?')){s=JSON.parse(JSON.stringify(sample));selectedEmployee='';persist();render();notify('Demo zurückgesetzt')}};render();setInterval(()=>{const c=$('#liveClock');if(c)c.textContent=time()},15000);
})();
</script></body></html>