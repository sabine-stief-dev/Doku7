<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex"/><meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet,noimageindex"/><meta name="bingbot" content="noindex,nofollow,noarchive,nosnippet,noimageindex"/><title>{title}</title><link rel="stylesheet" href="/design.css"/><style is:global>
:root{font-family:system-ui,-apple-system,sans-serif;background:#f3f6fa;color:#203449}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer;border:1px solid #b7c9d8;background:#fff;border-radius:9px;padding:10px 13px;color:#204363}button.primary{background:#176da7;color:white;border-color:#176da7}button.active{background:#d6eafa;border-color:#4484b3}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #5aa3ed}input,select,textarea{border:1px solid #b9cbd8;border-radius:8px;padding:9px;background:white;max-width:100%}textarea{width:100%;min-height:75px}header{background:#122f4b;color:white;padding:14px 20px}header .head{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;max-width:1400px;margin:auto}header h1{margin:0;font-size:24px}header small{color:#c7dae8}.shell{max-width:1400px;margin:auto;display:grid;grid-template-columns:230px minmax(0,1fr);gap:20px;padding:20px}.sidebar{background:#fff;border-radius:14px;padding:15px;align-self:start;position:sticky;top:15px}.sidebar button{display:block;width:100%;text-align:left;margin:5px 0}.content{min-width:0}.panel{background:white;border:1px solid #e0e9ef;border-radius:14px;padding:18px;margin-bottom:16px;box-shadow:0 2px 12px #1231}.panel h2,.panel h3{margin:0 0 12px}.muted{color:#65798b}.row{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap}.actions{display:flex;gap:8px;flex-wrap:wrap}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.tile{border:1px solid #dce8f1;border-radius:12px;padding:15px}.metric{font-size:28px;font-weight:700;color:#176da7}.id{font:10px ui-monospace,monospace;color:#8b647a;border:1px solid #dccdd6;border-radius:4px;padding:2px 4px;margin-right:5px;white-space:nowrap}.id.dark{color:#e7bdd3;border-color:#6c6880}table{border-collapse:collapse;width:100%}td,th{text-align:left;border-bottom:1px solid #e3ebf1;padding:11px 7px}th{font-size:13px;color:#5b7183}.scroll{overflow:auto}.badge{background:#e8f3fa;border-radius:8px;padding:5px 9px;font-size:12px}.warning{background:#fff5dd;padding:12px;border-radius:9px}.help{background:#e8f4ff;padding:12px;border-radius:9px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:grid;gap:5px}.field label{font-size:13px;color:#536e83}.hidden{display:none!important}.modalback{position:fixed;inset:0;background:#0d243bb0;display:flex;justify-content:center;align-items:center;padding:15px;z-index:10}.modal{width:min(600px,100%);max-height:90vh;overflow:auto;background:white;padding:22px;border-radius:14px}.modal form{display:grid;gap:12px}.editmark{outline:2px dashed #e49a55;outline-offset:3px}.foot{font-size:12px;color:#65798b;margin:20px 0}.tabs{display:flex;gap:7px;flex-wrap:wrap}.phone{max-width:390px;margin:12px auto;border:8px solid #263d53;border-radius:30px;background:white;padding:18px;min-height:510px}.phone .big{width:100%;padding:18px;font-size:18px;margin:8px 0}.clock{font-size:34px;text-align:center;font-weight:700;margin:22px 0}.note{font-size:13px;color:#566f81}.banner{padding:10px 13px;background:#dff1e9;border-radius:8px;margin:10px 0}.switch{display:flex;gap:8px;align-items:center}.switch input{width:18px;height:18px}@media(max-width:820px){.shell{grid-template-columns:1fr;padding:12px;gap:10px}.sidebar{position:static}.sidebar .navs{display:flex;overflow:auto;gap:5px}.sidebar button{white-space:nowrap;width:auto}.grid{grid-template-columns:1fr}.formgrid{grid-template-columns:1fr}header h1{font-size:20px}td,th{font-size:13px;padding:9px 5px}}
</style></head><body><header><div class="head"><div><h1><span class="id dark">X01</span> Docu7</h1><small>Modulares Wireframe · alle Bereiche mit Referenz-IDs</small></div><div class="actions"><button id="editToggle"><span class="id">X02</span> Bearbeitungsmodus</button><button id="export"><span class="id">X03</span> JSON exportieren</button><button id="reset"><span class="id">X04</span> Demo zurücksetzen</button></div></div></header><div class="shell"><aside class="sidebar"><div class="field"><label><span class="id">X05</span> Mandant / Firma</label><select id="tenant"></select></div><div class="actions" style="margin:10px 0"><button id="addTenant"><span class="id">X06</span> + Firma</button><button id="editTenant"><span class="id">X07</span> Firma ändern</button></div><div class="navs" id="navs"><button data-act="nav:dashboard">X10 Übersicht</button><button data-act="nav:employees">X20 Mitarbeiterverwaltung</button><button data-act="nav:times">X30 Arbeitszeiten</button><button data-act="nav:mobile">X40 Mitarbeiter-App</button><button data-act="nav:settings">X50 Verwaltung</button></div><p class="note"><span class="id">X08</span> Jede Funktion hat eine feste Kennung. Beispiel: „Bitte X42 ändern“.</p></aside><main class="content"><div class="row"><div><h2 id="pageTitle">Übersicht</h2><p class="muted" id="pageSub"></p></div><span class="badge" id="tenantBadge"></span></div><div id="page"></div><p class="foot">Nur ein klickbarer Prototyp mit Beispieldaten, kein produktives Zeiterfassungssystem. Daten liegen lokal im Browser. GitHub Pages ist öffentlich; keine echten Mitarbeiterdaten verwenden. Suchmaschinen werden per noindex ausgeschlossen, ohne Garantie für vollständige Unsichtbarkeit.</p></main></div><div id="modalBack" class="modalback hidden"><div class="modal"><div class="row"><h3 id="modalTitle"></h3><button id="modalClose"><span class="id">X09</span> Schließen</button></div><div id="modalContent"></div></div></div>
<script is:inline>
const pages=[['dashboard','X10','Übersicht'],['employees','X20','Mitarbeiterverwaltung'],['times','X30','Arbeitszeiten'],['mobile','X40','Mitarbeiter-App'],['settings','X50','Verwaltung'],['structure','X60','Wireframe-Editor']];
const initial={activeTenant:'t1',tenants:[{id:'t1',name:'Musterfirma Nord',industry:'Handwerk'},{id:'t2',name:'Beispielbetrieb Süd',industry:'Dienstleistung'}],employees:[{id:'e1',tenant:'t1',name:'Anna Becker',language:'Deutsch',role:'Mitarbeiter',active:true},{id:'e2',tenant:'t1',name:'Marek Nowak',language:'Polski',role:'Mitarbeiter',active:true},{id:'e3',tenant:'t2',name:'Elena Popescu',language:'Română',role:'Mitarbeiter',active:true}],entries:[{id:'z1',tenant:'t1',employee:'e1',date:'2026-10-15',start:'08:00',end:'16:30',break:'00:30',history:[]},{id:'z2',tenant:'t1',employee:'e2',date:'2026-10-15',start:'09:00',end:'',break:'00:30',history:[]},{id:'z3',tenant:'t2',employee:'e3',date:'2026-10-15',start:'08:30',end:'17:00',break:'00:45',history:[]}],labels:{},notes:{},hidden:{},settings:{},clock:{}};
const storeKey='docu7-wireframe-v3';let state;try{state=JSON.parse(localStorage.getItem(storeKey))}catch{}if(!state||!state.tenants)state=JSON.parse(JSON.stringify(initial));let page='dashboard',edit=false,mobileEmployee='';
const $=s=>document.querySelector(s);const html=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const id=(x)=>'<span class="id">'+x+'</span>';const tenant=()=>state.tenants.find(t=>t.id===state.activeTenant);const staff=()=>state.employees.filter(e=>e.tenant===state.activeTenant);const times=()=>state.entries.filter(e=>e.tenant===state.activeTenant);const name=e=>state.employees.find(x=>x.id===e)?.name||'Unbekannt';const uid=p=>p+Date.now().toString(36)+Math.random().toString(36).slice(2,5);function save(){localStorage.setItem(storeKey,JSON.stringify(state))}function label(code,fallback){return html(state.labels[code]||fallback)}function b(code,text,action,primary=false){return '<button class="'+(primary?'primary':'')+'" data-act="'+action+'">'+id(code)+label(code,text)+'</button>'}function field(code,title,type='text',value='',extra=''){return '<div class="field"><label>'+id(code)+label(code,title)+'</label><input data-code="'+code+'" name="'+code+'" type="'+type+'" value="'+html(value)+'" '+extra+'/></div>'}function modal(title,body,submit){$('#modalTitle').textContent=title;$('#modalContent').innerHTML='<form id="modalForm">'+body+'</form>';$('#modalBack').classList.remove('hidden');$('#modalForm').onsubmit=e=>{e.preventDefault();submit(new FormData(e.target))}}function close(){$('#modalBack').classList.add('hidden')}$('#modalClose').onclick=close;$('#modalBack').onclick=e=>{if(e.target===$('#modalBack'))close()};
function renderNav(){$('#navs').innerHTML=pages.map(([key,code,text])=>b(code,text,'nav:'+key)).join('');$('#tenant').innerHTML=state.tenants.map(t=>'<option value="'+html(t.id)+'" '+(t.id===state.activeTenant?'selected':'')+'>'+html(t.name)+'</option>').join('');$('#tenantBadge').textContent=tenant()?.name||'';$('#tenant').value=state.activeTenant}
function render(){renderNav();$('#pageTitle').textContent=pages.find(p=>p[0]===page)?.[2]||'Übersicht';$('#pageSub').textContent=edit?'Bearbeitungsmodus: Element anklicken, um Bezeichnung oder Notiz zu ändern.':'Klicke durch die Funktionen. Jede Schaltfläche hat eine feste ID.';$('#editToggle').classList.toggle('active',edit);let content='';if(page==='dashboard')content=dashboard();if(page==='employees')content=employees();if(page==='times')content=timesPage();if(page==='mobile')content=mobile();if(page==='settings')content=settings();if(page==='structure')content=structure();$('#page').innerHTML=content;document.querySelectorAll('[data-act]').forEach(el=>el.onclick=()=>act(el.dataset.act));if(edit)document.querySelectorAll('[data-act]').forEach(el=>{el.classList.add('editmark');el.onclick=()=>editElement(el)});const f=$('#staffFilter');if(f)f.onchange=()=>{$('#timeTable').innerHTML=timeRows(f.value);bindRows()};bindRows();const mp=$('#mobilePerson');if(mp)mp.onchange=e=>{mobileEmployee=e.target.value;render()}}
function dashboard(){return '<div class="grid"><div class="tile">'+id('X11')+'<h3>Mitarbeiter</h3><div class="metric">'+staff().length+'</div></div><div class="tile">'+id('X12')+'<h3>Heutige Buchungen</h3><div class="metric">'+times().length+'</div></div><div class="tile">'+id('X13')+'<h3>Offene Buchungen</h3><div class="metric">'+times().filter(t=>!t.end).length+'</div></div></div><div class="panel"><h3>'+id('X14')+'Schnellaktionen</h3><div class="actions">'+b('X15','Mitarbeiter anlegen','employee:new',true)+b('X16','Zeiten korrigieren','nav:times')+b('X17','Mitarbeiter-App testen','nav:mobile')+'</div></div><div class="panel"><h3>'+id('X18')+'Mandantenfähigkeit</h3><p>Jede Firma hat ihre eigenen Mitarbeiter, Zeitbuchungen und Einstellungen. Wechsle links die Firma, um getrennte Daten zu sehen.</p></div>'}
function employees(){return '<div class="panel"><div class="row"><h3>'+id('X21')+'Mitarbeiter dieser Firma</h3>'+b('X22','+ Mitarbeiter anlegen','employee:new',true)+'</div><p class="muted">Anlegen auch ohne E-Mail; App-Sprache pro Mitarbeiter festlegen.</p><div class="scroll"><table><thead><tr><th>'+id('X23')+'Name</th><th>'+id('X24')+'Sprache</th><th>'+id('X25')+'Rolle</th><th>'+id('X26')+'Status</th><th>Aktion</th></tr></thead><tbody>'+staff().map(e=>'<tr><td>'+html(e.name)+'</td><td>'+html(e.language)+'</td><td>'+html(e.role)+'</td><td>'+(e.active?'Aktiv':'Inaktiv')+'</td><td>'+b('X27','Bearbeiten','employee:'+e.id)+'</td></tr>').join('')+'</tbody></table></div></div>'}
function timesPage(){return '<div class="panel"><div class="row"><h3>'+id('X31')+'Zeiterfassungen</h3>'+b('X32','+ Fehlende Zeit ergänzen','time:new',true)+'</div><div class="field" style="max-width:300px"><label>'+id('X33')+'Mitarbeiterfilter</label><select id="staffFilter"><option value="all">Alle Mitarbeiter</option>'+staff().map(e=>'<option value="'+e.id+'">'+html(e.name)+'</option>').join('')+'</select></div><div class="scroll"><table><thead><tr><th>'+id('X34')+'Datum</th><th>Mitarbeiter</th><th>Beginn</th><th>Ende</th><th>Pause</th><th>Änderungen</th><th>Aktion</th></tr></thead><tbody id="timeTable">'+timeRows('all')+'</tbody></table></div></div><div class="warning">'+id('X38')+'Konzept: Jede Änderung braucht einen Grund und eine nachvollziehbare Historie. In der späteren Produktiv-App serverseitig und manipulationsgeschützt speichern.</div>'}
function timeRows(filter){return times().filter(t=>filter==='all'||t.employee===filter).map(t=>'<tr><td>'+html(t.date)+'</td><td>'+html(name(t.employee))+'</td><td>'+html(t.start)+'</td><td>'+html(t.end||'OFFEN')+'</td><td>'+html(t.break)+'</td><td>'+t.history.length+'</td><td>'+b('X35','Korrigieren','time:'+t.id')+' '+b('X36','Verlauf','history:'+t.id)+'</td></tr>').join('')}
function bindRows(){}
function mobile(){const e=staff().find(e=>e.id===mobileEmployee)||staff()[0];if(e)mobileEmployee=e.id;return '<div class="panel"><h3>'+id('X41')+'Mitarbeiteransicht (Smartphone-Vorschau)</h3><label>'+id('X42')+'Demo-Mitarbeiter <select id="mobilePerson">'+staff().map(x=>'<option value="'+x.id+'" '+(x.id===mobileEmployee?'selected':'')+'>'+html(x.name)+'</option>').join('')+'</select></label><div class="phone"><div class="row"><strong>Docu7</strong><span class="badge">'+html(e?.language||'Deutsch')+'</span></div><div class="tabs">'+b('X43','Stempeluhr','mobile:clock')+b('X44','Meine Zeiten','mobile:list')+b('X45','Profil','mobile:profile')+'</div><div id="mobileInner">'+mobileInner(e)+'</div></div><p class="note">Die mobile Ansicht ist eine klickbare Simulation. Offene Tage und Nachträge sind als Grundidee vorgesehen; keine echte Arbeitszeiterfassung.</p></div>'}
let mobileTab='clock';function mobileInner(e){if(!e)return '<p>Bitte zuerst Mitarbeiter anlegen.</p>';if(mobileTab==='profile')return '<h3>'+id('X46')+'Profil</h3><p>'+html(e.name)+'</p><p>Sprache: '+html(e.language)+'</p>';if(mobileTab==='list')return '<h3>'+id('X47')+'Meine Zeiten</h3>'+times().filter(t=>t.employee===e.id).map(t=>'<p>'+html(t.date)+' · '+html(t.start)+' – '+html(t.end||'offen')+'</p>').join('')+b('X48','Zeit nachtragen','mobile:manual');const c=state.clock[e.id];return '<h3>'+id('X49')+'Stempeluhr</h3><div class="clock">'+(c?'Eingestempelt':'Bereit')+'</div>'+b('X4A',c?'Ausstempeln':'Einstempeln','mobile:stamp',true)+'<p class="note">Pause und Arbeitszeit werden im fertigen Produkt gesondert und zuverlässig erfasst.</p>'}
function settings(){const s=state.settings[state.activeTenant]||{};return '<div class="panel"><h3>'+id('X51')+'Mandanten-Einstellungen</h3><div class="formgrid"><div class="field"><label>'+id('X52')+'Standardsprache</label><select id="defaultLang">'+['Deutsch','English','Polski','Română','Türkçe','Українська','العربية','Русский'].map(l=>'<option '+(s.language===l?'selected':'')+'>'+l+'</option>').join('')+'</select></div><div class="field"><label>'+id('X53')+'Zeitmodell</label><select id="workModel"><option>Flexible Arbeitszeit</option><option '+(s.model==='Feste Arbeitszeit'?'selected':'')+'>Feste Arbeitszeit</option></select></div></div><p>'+b('X54','Einstellungen speichern','settings:save',true)+'</p></div><div class="panel"><h3>'+id('X55')+'Berechtigungen & Datenschutz</h3><p>Konzept: Chef/Admin darf Zeiten korrigieren. Änderungen sollen dokumentiert und Mitarbeiter informiert werden. Die Demo besitzt noch keine echte Anmeldung oder Rollenprüfung.</p></div><div class="panel"><h3>'+id('X56')+'KI-Hilfe – Konzeptvorschau</h3><p>Frage: Wie lege ich einen Mitarbeiter an?</p>'+b('X57','Beispielantwort zeigen','help')+'<div id="helpOutput"></div></div>'}
function structure(){return '<div class="panel"><h3>'+id('X61')+'Alle Referenz-IDs</h3><p>Jede Hauptseite, wichtige Funktion und jedes Formularfeld hat eine ID. Wiederholte Tabellenaktionen verwenden dieselbe Funktions-ID; der Datensatz wird separat über eine interne Kennung identifiziert.</p><div class="grid">'+pages.map(p=>'<div class="tile">'+id(p[1])+' '+p[2]+'</div>').join('')+'</div></div><div class="panel"><h3>'+id('X62')+'Änderungswünsche festhalten</h3><p>Bearbeitungsmodus aktivieren, dann einen Button anklicken und eine neue Beschriftung oder Notiz hinterlegen. Änderungen werden lokal gespeichert und mit JSON exportiert.</p>'+b('X63','Bearbeitungsmodus umschalten','edit')+'</div><div class="panel"><h3>'+id('X64')+'Weitere Entwicklung</h3><p>Das Grundgerüst ist modular in Mandanten, Mitarbeiter, Zeitbuchungen und Oberflächenbereiche aufgeteilt. Für die spätere echte App benötigen wir Backend, Datenbank, Authentifizierung, Rechteprüfung, revisionssichere Historie und Tests.</p></div>'}
function editElement(el){const code=el.querySelector('.id')?.textContent||'X?';const current=el.textContent.replace(code,'').trim();modal('Element '+code+' bearbeiten','<div class="field"><label>Neue Beschriftung</label><input name="text" value="'+html(state.labels[code]||current)+'"/></div><div class="field"><label>Notiz / Änderungswunsch</label><textarea name="note">'+html(state.notes[code]||'')+'</textarea></div><button class="primary">Speichern</button>',f=>{state.labels[code]=f.get('text');state.notes[code]=f.get('note');save();close();render()})}
function employeeForm(e){const options=['Deutsch','English','Polski','Română','Türkçe','Українська','العربية','Русский'];modal(e?'Mitarbeiter bearbeiten':'Mitarbeiter anlegen','<div class="formgrid">'+field('X28','Name','text',e?.name||'','required maxlength="80"')+'<div class="field"><label>'+id('X29')+'App-Sprache</label><select name="language">'+options.map(l=>'<option '+(e?.language===l?'selected':'')+'>'+l+'</option>').join('')+'</select></div><div class="field"><label>'+id('X2A')+'Rolle</label><select name="role"><option>Mitarbeiter</option><option '+(e?.role==='Teamleitung'?'selected':'')+'>Teamleitung</option><option '+(e?.role==='Admin'?'selected':'')+'>Admin</option></select></div><div class="field"><label>'+id('X2B')+'Status</label><select name="active"><option value="yes">Aktiv</option><option value="no" '+(e&&!e.active?'selected':'')+'>Inaktiv</option></select></div></div><p class="note">Keine E-Mail notwendig (Konzept). Keine echten Zugänge werden erstellt.</p><button class="primary">'+id('X2C')+'Speichern</button>',f=>{const item={id:e?.id||uid('e'),tenant:state.activeTenant,name:f.get('X28'),language:f.get('language'),role:f.get('role'),active:f.get('active')==='yes'};if(e)Object.assign(e,item);else state.employees.push(item);save();close();render()})}
function timeForm(t){const people=staff();if(!people.length){alert('Bitte zuerst einen Mitarbeiter anlegen.');return}modal(t?'Zeitbuchung korrigieren':'Fehlende Zeit ergänzen','<div class="formgrid"><div class="field"><label>'+id('X37')+'Mitarbeiter</label><select name="employee">'+people.map(e=>'<option value="'+e.id+'" '+(t?.employee===e.id?'selected':'')+'>'+html(e.name)+'</option>').join('')+'</select></div>'+field('X39','Datum','date',t?.date||'2026-10-15','required')+field('X3A','Beginn','time',t?.start||'08:00','required')+field('X3B','Ende','time',t?.end||'17:00','required')+field('X3C','Pause','time',t?.break||'00:30','required')+'</div><div class="field"><label>'+id('X3D')+'Begründung der Änderung</label><textarea name="reason" required placeholder="Warum wird diese Zeit korrigiert?"></textarea></div><button class="primary">'+id('X3E')+'Korrektur speichern</button>',f=>{const next={employee:f.get('employee'),date:f.get('X39'),start:f.get('X3A'),end:f.get('X3B'),break:f.get('X3C')};if(t){t.history.push({before:{employee:t.employee,date:t.date,start:t.start,end:t.end,break:t.break},reason:f.get('reason'),at:new Date().toISOString()});Object.assign(t,next)}else state.entries.push({id:uid('z'),tenant:state.activeTenant,...next,history:[{before:null,reason:f.get('reason'),at:new Date().toISOString()}]});save();close();render()})}
function act(action){if(action.startsWith('nav:')){page=action.slice(4);render();return}if(action==='edit'){edit=!edit;render();return}if(action.startsWith('employee:')){employeeForm(state.employees.find(e=>e.id===action.slice(9)));return}if(action.startsWith('time:')){timeForm(state.entries.find(t=>t.id===action.slice(5)));return}if(action==='time:new'){timeForm();return}if(action.startsWith('history:')){const t=state.entries.find(t=>t.id===action.slice(8));modal('Änderungsverlauf '+t.id,'<div class="stack">'+(t.history.length?t.history.map(h=>'<div class="tile"><strong>'+html(h.at)+'</strong><p>Grund: '+html(h.reason)+'</p><pre style="white-space:pre-wrap">'+html(JSON.stringify(h.before,null,2))+'</pre></div>').join(''):'Keine Änderungen vorhanden')+'</div><button type="submit">Schließen</button>',()=>close());return}if(action.startsWith('mobile:')){const v=action.slice(7);if(['clock','list','profile'].includes(v)){mobileTab=v;render()}if(v==='stamp'){if(!mobileEmployee)return;state.clock[mobileEmployee]=!state.clock[mobileEmployee];save();render()}if(v==='manual'){alert('Wireframe: Nachtrag soll nur offene Tage anzeigen. Die konkrete Eingabemaske wird als nächster Baustein ergänzt.')}return}if(action==='settings:save'){state.settings[state.activeTenant]={language:$('#defaultLang').value,model:$('#workModel').value};save();alert('Demo-Einstellungen gespeichert.');return}if(action==='help'){$('#helpOutput').innerHTML='<div class="help">Öffne Mitarbeiterverwaltung (X20), klicke auf „Mitarbeiter anlegen“ (X22), trage den Namen ein (X28), wähle die Sprache (X29) und speichere (X2C). Dies ist noch keine echte KI.</div>';return}}
$('#editToggle').onclick=()=>{edit=!edit;render()};$('#tenant').onchange=e=>{state.activeTenant=e.target.value;mobileEmployee='';save();render()};$('#addTenant').onclick=()=>tenantForm();$('#editTenant').onclick=()=>tenantForm(tenant());function tenantForm(t){modal(t?'Firma bearbeiten':'Neuen Mandanten anlegen',field('X70','Firmenname','text',t?.name||'','required')+field('X71','Branche','text',t?.industry||'')+'<button class="primary">'+id('X72')+'Speichern</button>',f=>{if(t){t.name=f.get('X70');t.industry=f.get('X71')}else{const x={id:uid('t'),name:f.get('X70'),industry:f.get('X71')};state.tenants.push(x);state.activeTenant=x.id}save();close();render()})}
$('#export').onclick=()=>{const a=document.createElement('a'),url=URL.createObjectURL(new Blob([JSON.stringify({exportedAt:new Date().toISOString(),state},null,2)],{type:'application/json'}));a.href=url;a.download='docu7-wireframe-konzept.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};window.addEventListener('error',function(e){const target=document.querySelector('#page');if(target&&!target.innerHTML.trim())target.innerHTML='<div class="panel"><h3>Die App konnte nicht vollständig starten</h3><p>Bitte Seite neu laden. Fehler: '+String(e.message||'Unbekannt')+'</p></div>';});$('#reset').onclick=()=>{if(confirm('Alle lokalen Demodaten und Beschriftungen zurücksetzen?')){state=JSON.parse(JSON.stringify(initial));save();render()}};render();
</script></body></html>