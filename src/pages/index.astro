---
const sections=[{id:'overview',label:'Übersicht',icon:'▦'},{id:'staff',label:'Mitarbeiter',icon:'♙'},{id:'times',label:'Arbeitszeiten',icon:'◷'},{id:'admin',label:'Verwaltung',icon:'⚙'}];
---
<!doctype html><html lang="de"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex"/><meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet,noimageindex"/><meta name="bingbot" content="noindex,nofollow,noarchive,nosnippet,noimageindex"/><title>Docu7 · Klickbarer App-Dummy</title><style>
:root{font-family:Inter,system-ui,-apple-system,sans-serif;color:#19334c;background:#f5f7fa}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button{cursor:pointer}aside{position:fixed;left:0;top:0;bottom:0;width:232px;background:#122d49;color:#fff;padding:22px 14px}aside h1{margin:2px 10px 5px;font-size:28px}aside p{font-size:12px;margin:0 10px 26px;color:#b9cde0}aside button{width:100%;background:none;color:#d7e7f5;border:0;text-align:left;padding:13px 12px;border-radius:9px;margin:2px 0}aside button.active,aside button:hover{background:#27577e;color:white}main{margin-left:232px;padding:28px;max-width:1350px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px}.pill{background:#e5eff9;color:#25618f;border-radius:20px;padding:6px 12px;font-size:12px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.card{background:white;border:1px solid #e4eaf0;border-radius:15px;padding:20px;box-shadow:0 2px 9px #1832;margin:14px 0}.card h3{margin:0 0 9px}.stat{font-size:32px;font-weight:750;color:#176caa}.muted{color:#65798a}.btn{border:0;background:#176eac;color:#fff;border-radius:9px;padding:11px 15px}.secondary{border:1px solid #c4d4df;background:white;color:#225271;border-radius:9px;padding:10px 14px}.row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.stack{display:grid;gap:10px}input,select{border:1px solid #c9d5e0;border-radius:8px;padding:10px;min-width:0}table{width:100%;border-collapse:collapse}td,th{text-align:left;border-bottom:1px solid #e8edf2;padding:13px 8px}th{font-size:13px;color:#6a7d8d}.hidden{display:none!important}.modalwrap{position:fixed;inset:0;background:#102a45a6;display:flex;align-items:center;justify-content:center;padding:15px;z-index:9}.modal{background:white;border-radius:15px;padding:24px;width:min(460px,100%)}.modal label{display:grid;gap:5px;margin:12px 0}.modal input,.modal select{width:100%}.hint{font-size:13px;color:#667c8d}.notice{background:#e9f4fc;border-radius:10px;padding:13px;margin:12px 0}.chip{background:#e9f1f7;border-radius:7px;padding:5px 9px;font-size:12px}.actions{display:flex;gap:8px;flex-wrap:wrap}a{color:#176eac}@media(max-width:760px){aside{position:sticky;top:0;width:auto;padding:10px;z-index:2}aside h1{font-size:20px;margin:0 6px}aside p{display:none}aside nav{display:flex;overflow:auto;gap:5px}aside button{white-space:nowrap;width:auto;font-size:13px;padding:9px}main{margin:0;padding:15px}.grid{grid-template-columns:1fr}.top{align-items:flex-start}table{font-size:13px}td,th{padding:9px 4px}}
</style></head><body><aside><h1>Docu7</h1><p>Zeiterfassung · Arbeitgeber-Backend</p><nav>{sections.map(s=><button class:list={[s.id==='overview'&&'active']} data-nav={s.id}>{s.icon} &nbsp; {s.label}</button>)}</nav></aside><main><div class="top"><div><h2 id="heading">Übersicht</h2><p class="muted" id="subtitle">Willkommen in deinem klickbaren Arbeitgeber-Backend.</p></div><span class="pill">Interaktiver Prototyp · keine echten Daten</span></div>
<section data-page="overview"><div class="grid"><div class="card"><h3>Mitarbeiter</h3><div class="stat" id="staffCount">3</div><span class="muted">im Demo-Unternehmen</span></div><div class="card"><h3>Heute eingestempelt</h3><div class="stat">2</div><span class="muted">Beispieldaten</span></div><div class="card"><h3>Offene Buchungen</h3><div class="stat">1</div><span class="muted">Korrektur prüfen</span></div></div><div class="card"><h3>Schnellaktionen</h3><div class="actions"><button class="btn" data-go="staff" data-add>+ Mitarbeiter anlegen</button><button class="secondary" data-go="times">Arbeitszeiten prüfen</button><button class="secondary" data-go="admin">Einstellungen öffnen</button></div></div><div class="card"><h3>Was ist Docu7?</h3><p>Ein bewusst einfacher Zeiterfassungs-Dummy: Mitarbeiter verwalten, Zeiten ansehen und Korrekturen ausprobieren. Die echte App ist noch nicht entwickelt.</p><div class="notice">Die Demo speichert neue Mitarbeiter und Korrekturen nur lokal in deinem Browser. Keine Verbindung zu einer Personaldatenbank.</div></div></section>
<section data-page="staff" class="hidden"><div class="card"><div class="row"><h3>Mitarbeiterverwaltung</h3><button class="btn" id="addStaff">+ Mitarbeiter anlegen</button></div><p class="muted">Mitarbeiter können auch ohne E-Mail angelegt werden. Die Sprache wird beim Anlegen gewählt.</p><div style="overflow-x:auto"><table><thead><tr><th>Name</th><th>Sprache</th><th>Status</th><th>Aktion</th></tr></thead><tbody id="staffRows"></tbody></table></div></div></section>
<section data-page="times" class="hidden"><div class="card"><div class="row"><h3>Arbeitszeiten</h3><label>Person <select id="personFilter"><option value="all">Alle Mitarbeiter</option></select></label></div><div style="overflow-x:auto"><table><thead><tr><th>Datum</th><th>Mitarbeiter</th><th>Beginn</th><th>Ende</th><th>Pause</th><th>Aktion</th></tr></thead><tbody id="timeRows"></tbody></table></div></div><div class="notice">Änderungen werden im Dummy nur lokal gespeichert. In der späteren echten App sind Änderungsprotokoll, Originalwerte und Zugriffsrechte vorzusehen.</div></section>
<section data-page="admin" class="hidden"><div class="card"><h3>Verwaltung & Einstellungen</h3><div class="stack"><label>Standardsprache <select id="defaultLanguage"><option>Deutsch</option><option>English</option><option>Polski</option><option>Română</option><option>Türkçe</option><option>Українська</option><option>العربية</option><option>Русский</option></select></label><label><input type="checkbox" checked disabled/> Änderungen an Zeiten protokollieren (Konzeptvorgabe)</label><label><input type="checkbox" checked disabled/> Originaleinträge aufbewahren (Konzeptvorgabe)</label><label><input type="checkbox" checked disabled/> Arbeitgeberkorrekturen erlauben (Konzeptvorgabe)</label></div></div><div class="card"><h3>Funktionsplaner</h3><p>Welche Funktionen soll Docu7 später wirklich bekommen? Der separate Entscheidungsfragebogen ist weiterhin vorhanden.</p><a href="./planer/">Funktionsplaner öffnen →</a></div><div class="card"><h3>KI-Hilfe – Vorschau</h3><p>In der späteren App könnte eine KI Fragen wie „Wie lege ich einen Mitarbeiter an?“ mit passenden Screenshots und Anleitungen beantworten.</p><button class="secondary" id="helpDemo">Beispielantwort anzeigen</button><p id="helpText" class="hidden notice">Öffne „Mitarbeiter“, tippe auf „+ Mitarbeiter anlegen“, gib den Namen ein, wähle die Sprache und tippe auf „Speichern“. Das ist eine fest hinterlegte Demo-Antwort, noch keine echte KI.</p></div></section>
</main><div class="modalwrap hidden" id="modalWrap"><div class="modal"><div class="row"><h3 id="modalTitle">Mitarbeiter anlegen</h3><button class="secondary" id="closeModal">Schließen</button></div><div id="modalBody"></div></div></div>
<script is:inline>
const key='docu7-backend-demo';const demo=[{id:1,name:'Anna Becker',lang:'Deutsch',active:true},{id:2,name:'Marek Nowak',lang:'Polski',active:true},{id:3,name:'Elena Popescu',lang:'Română',active:true}];const initial=[{id:1,day:'15.10.2026',person:1,start:'08:00',end:'16:30',break:'00:30'},{id:2,day:'15.10.2026',person:2,start:'09:00',end:'17:00',break:'00:30'},{id:3,day:'14.10.2026',person:3,start:'08:30',end:'',break:'00:30'}];let state;try{state=JSON.parse(localStorage.getItem(key))}catch{}if(!state||!Array.isArray(state.staff))state={staff:demo,times:initial};const $=s=>document.querySelector(s);const escapeHTML=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function save(){localStorage.setItem(key,JSON.stringify(state))}function go(page){document.querySelectorAll('[data-page]').forEach(e=>e.classList.toggle('hidden',e.dataset.page!==page));document.querySelectorAll('[data-nav]').forEach(e=>e.classList.toggle('active',e.dataset.nav===page));const labels={overview:['Übersicht','Alles Wichtige auf einen Blick'],staff:['Mitarbeiter','Anlegen, bearbeiten und verwalten'],times:['Arbeitszeiten','Zeiten ansehen und korrigieren'],admin:['Verwaltung','Einstellungen und weitere Ideen']};$('#heading').textContent=labels[page][0];$('#subtitle').textContent=labels[page][1];render()}document.querySelectorAll('[data-nav]').forEach(e=>e.onclick=()=>go(e.dataset.nav));document.querySelectorAll('[data-go]').forEach(e=>e.onclick=()=>{go(e.dataset.go);if(e.hasAttribute('data-add'))openStaff()});function modal(title,html,submit){$('#modalTitle').textContent=title;$('#modalBody').innerHTML=html;$('#modalWrap').classList.remove('hidden');$('#modalBody').querySelector('form').onsubmit=e=>{e.preventDefault();submit(new FormData(e.target))}}function close(){$('#modalWrap').classList.add('hidden')}$('#closeModal').onclick=close;$('#modalWrap').onclick=e=>{if(e.target===$('#modalWrap'))close()};function openStaff(id){const person=state.staff.find(p=>p.id===id);modal(person?'Mitarbeiter bearbeiten':'Mitarbeiter anlegen',`<form><label>Name<input name="name" required maxlength="80" value="${escapeHTML(person?.name||'')}"/></label><label>App-Sprache<select name="lang">${['Deutsch','English','Polski','Română','Türkçe','Українська','العربية','Русский'].map(l=>`<option ${person?.lang===l?'selected':''}>${l}</option>`).join('')}</select></label><label>Status<select name="active"><option value="yes">Aktiv</option><option value="no" ${person&&!person.active?'selected':''}>Inaktiv</option></select></label><p class="hint">Demo ohne echte E-Mail-Einladung.</p><button class="btn">Speichern</button></form>`,f=>{if(person){person.name=f.get('name');person.lang=f.get('lang');person.active=f.get('active')==='yes'}else state.staff.push({id:Date.now(),name:f.get('name'),lang:f.get('lang'),active:f.get('active')==='yes'});save();render();close()})}$('#addStaff').onclick=()=>openStaff();function editTime(id){const t=state.times.find(x=>x.id===id);modal('Arbeitszeit korrigieren',`<form><p class="muted">${escapeHTML(state.staff.find(p=>p.id===t.person)?.name||'')}</p><label>Beginn<input type="time" name="start" value="${t.start}" required/></label><label>Ende<input type="time" name="end" value="${t.end}" required/></label><label>Pause<input type="time" name="break" value="${t.break}" required/></label><label>Begründung<input name="reason" placeholder="z. B. Ausstempeln vergessen" required/></label><button class="btn">Korrektur speichern</button></form>`,f=>{t.history=t.history||[];t.history.push({start:t.start,end:t.end,break:t.break,reason:f.get('reason'),at:new Date().toISOString()});t.start=f.get('start');t.end=f.get('end');t.break=f.get('break');save();render();close()})}function render(){const names=state.staff;$('#staffCount').textContent=names.length;$('#staffRows').innerHTML=names.map(p=>`<tr><td>${escapeHTML(p.name)}</td><td>${escapeHTML(p.lang)}</td><td><span class="chip">${p.active?'Aktiv':'Inaktiv'}</span></td><td><button class="secondary" data-editstaff="${p.id}">Bearbeiten</button></td></tr>`).join('');document.querySelectorAll('[data-editstaff]').forEach(b=>b.onclick=()=>openStaff(Number(b.dataset.editstaff)));const filter=$('#personFilter');const prev=filter.value;filter.innerHTML='<option value="all">Alle Mitarbeiter</option>'+names.map(p=>`<option value="${p.id}">${escapeHTML(p.name)}</option>`).join('');filter.value=prev;$('#timeRows').innerHTML=state.times.filter(t=>filter.value==='all'||String(t.person)===filter.value).map(t=>`<tr><td>${t.day}</td><td>${escapeHTML(names.find(p=>p.id===t.person)?.name||'')}</td><td>${t.start}</td><td>${t.end||'Offen'}</td><td>${t.break}</td><td><button class="secondary" data-edittime="${t.id}">Korrigieren</button></td></tr>`).join('');document.querySelectorAll('[data-edittime]').forEach(b=>b.onclick=()=>editTime(Number(b.dataset.edittime)))}$('#personFilter').onchange=render;$('#helpDemo').onclick=()=>$('#helpText').classList.toggle('hidden');render();
</script></body></html>