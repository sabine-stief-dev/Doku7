---
const topics = ['Mitarbeiter anlegen','Mitarbeiter bearbeiten','Mitarbeiter deaktivieren','Mitarbeiter ohne E-Mail','Sprache pro Mitarbeiter','Teams und Standorte','Rollen und Rechte','Ein- und Ausstempeln','Pausen erfassen','Manuelle Nachträge','Offene Tage','Offline-Erfassung','Zeiten korrigieren','Änderungsprotokoll','Korrekturbegründung','Mitarbeiter benachrichtigen','Dashboard','Suche und Filter','Schnellaktionen','Monatsübersicht','PDF-Export','Excel-Export','Überstundenbericht','Lohnabrechnung','FAQ','Schrittanleitung','Videoanleitung','KI-Assistent','Interaktive Hilfe','Mehrsprachigkeit','Erinnerungen','Arbeitszeitregeln','2FA','Backups','Datenschutz'];
---
<html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Docu7 Funktionsplaner</title><meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex"/><style>
*{box-sizing:border-box}body{margin:0;background:#f1f6fb;color:#19334a;font:16px system-ui,sans-serif}header{background:#174a79;color:white;padding:28px 18px}main,header>div{max-width:800px;margin:auto}main{padding:16px}.card{background:white;padding:18px;margin:12px 0;border-radius:14px;box-shadow:0 2px 8px #1231}h1{margin:0}h2{font-size:18px}button{border:1px solid #9eb6ca;border-radius:9px;padding:10px 17px;background:white;font:inherit;cursor:pointer;margin:4px}button.active{background:#1764a1;color:white}label{display:block;margin-top:10px;font-size:14px}select,textarea{width:100%;padding:10px;border:1px solid #adc0d0;border-radius:8px;font:inherit}textarea{min-height:70px}.details{background:#f1f6fb;padding:14px;margin-top:12px;border-radius:10px}.muted{color:#60768a}nav{display:flex;flex-wrap:wrap;gap:5px}@media(max-width:450px){button{padding:10px 14px}}
</style></head><body><header><div><h1>Docu7 – App-Funktionsplaner</h1><p>Was soll unsere Zeiterfassungs-App können? Entscheide mit Ja oder Nein. Bei Ja erscheinen Detailfragen.</p></div></header><main><nav><button id="json">JSON herunterladen</button><button id="csv">CSV herunterladen</button><button onclick="window.print()">Drucken</button><button id="clear">Zurücksetzen</button></nav><p id="progress"></p><div id="questions"></div><p class="muted">Antworten werden nur in deinem Browser gespeichert. Bitte keine vertraulichen Mitarbeiterdaten eingeben.</p></main>
<script define:vars={{topics}}>
const key='docu7-planner-v1';let state={};try{state=JSON.parse(localStorage.getItem(key)||'{}')}catch{}
const host=document.querySelector('#questions');
const clean=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function save(){localStorage.setItem(key,JSON.stringify(state))}
function draw(){host.innerHTML='';topics.forEach((topic,i)=>{const a=state[i]||{};const div=document.createElement('section');div.className='card';div.innerHTML='<h2>'+(i+1)+'. '+clean(topic)+'</h2><button data-v="Ja" class="'+(a.answer==='Ja'?'active':'')+'">Ja</button><button data-v="Nein" class="'+(a.answer==='Nein'?'active':'')+'">Nein</button>'+(a.answer==='Ja'?'<div class="details"><label>Priorität</label><select data-f="priority"><option value="">Auswählen</option><option>Muss zum Start</option><option>Später</option><option>Optional</option></select><label>Wo soll es erscheinen?</label><select data-f="location"><option value="">Auswählen</option><option>Arbeitgeber-Backend</option><option>Mitarbeiter-App</option><option>Beides</option></select><label>Wer darf es verwenden?</label><select data-f="role"><option value="">Auswählen</option><option>Chef / Admin</option><option>Vorgesetzte</option><option>Alle</option></select><label>Welche Buttons, Eingaben und Abläufe wünschst du?</label><textarea data-f="buttons" placeholder="z. B. Hinzufügen, Speichern, Bestätigen"></textarea><label>Weitere Details</label><textarea data-f="notes" placeholder="Deine Vorstellungen..."></textarea></div>':'');div.querySelectorAll('[data-v]').forEach(b=>b.onclick=()=>{state[i]={...state[i],answer:b.dataset.v};save();draw()});div.querySelectorAll('[data-f]').forEach(el=>{el.value=a[el.dataset.f]||'';el.oninput=()=>{state[i]={...state[i],[el.dataset.f]:el.value};save()}});host.appendChild(div)});document.querySelector('#progress').textContent=Object.values(state).filter(x=>x.answer).length+' von '+topics.length+' beantwortet'}
function rows(){return topics.map((t,i)=>({funktion:t,...state[i]}))}
function download(name,type,s){const u=URL.createObjectURL(new Blob([s],{type}));const a=document.createElement('a');a.href=u;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)}
document.querySelector('#json').onclick=()=>download('docu7-antworten.json','application/json',JSON.stringify(rows(),null,2));
document.querySelector('#csv').onclick=()=>{const cols=['funktion','answer','priority','location','role','buttons','notes'];download('docu7-antworten.csv','text/csv','\uFEFF'+[cols.join(';'),...rows().map(r=>cols.map(k=>'"'+String(r[k]||'').replace(/"/g,'""')+'"').join(';'))].join('\r\n'))};
document.querySelector('#clear').onclick=()=>{if(confirm('Alle Antworten löschen?')){state={};save();draw()}};draw();
</script></body></html>